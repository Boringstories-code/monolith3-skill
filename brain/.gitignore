# --- machine noise ---
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# --- logs and scratch ---
logs/
*.log
.scratch/
.tmp/
tmp/

# --- agent runtime (never commit sessions, auth, or caches) ---
.grok/config.toml
.claude/settings.local.json
**/auth.json
**/sessions/
**/marketplace-cache/

# --- secrets. The vault holds the INDEX only, never values. ---
.env
.env.*
*.pem
*.key
*.p12
credentials.json
secrets.*

# --- big binaries. Keep the vault text. Point notes at media living elsewhere. ---
*.mov
*.mp4
*.avi
*.wav
*.flac
*.aif
*.aiff
*.zip
*.dmg
*.iso
*.psd
*.sketch

# Exception: small reference images notes point at are fine.
!images/**/*.png
!images/**/*.jpg
!images/**/*.svg

# --- Obsidian, if you use it as a plain viewer ---
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# --- generated by scripts/wire-runtimes.sh, never shipped ---
.claude/skills
.grok/skills
.codex/
